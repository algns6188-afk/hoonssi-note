{
  "name": "hoonssi-note",
  "productName": "강철노트",
  "version": "0.5.0",
  "description": "강철노트 - 팀 업무·회의·선수 관리 종합 노트",
  "main": "./out/main/index.js",
  "author": "강철노트",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.hoonssi.note",
    "productName": "강철노트",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "KangcheolNote-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "강철노트",
      "installerLanguages": [
        "ko_KR"
      ],
      "language": "1042"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "artifactName": "KangcheolNote-${version}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "회의 녹음을 위해 마이크를 사용합니다.",
        "NSScreenCaptureUsageDescription": "온라인 회의 소리를 함께 녹음하기 위해 사용합니다."
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "algns6188-afk",
        "repo": "hoonssi-note"
      }
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@supabase/supabase-js": "^2.119.0",
    "electron-updater": "^6.8.11",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "repository": "https://github.com/algns6188-afk/hoonssi-note"
}
